{
  "name": "@satee/openfeature-provider",
  "version": "0.1.0",
  "description": "OpenFeature provider for reading Satee feature flags in Node",
  "keywords": [
    "openfeature",
    "feature-flags",
    "satee"
  ],
  "homepage": "https://github.com/satee-dev/openfeature-provider-node#readme",
  "bugs": "https://github.com/satee-dev/openfeature-provider-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satee-dev/openfeature-provider-node.git"
  },
  "license": "MIT",
  "author": "Satee",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "22.20.7",
    "typescript": "7.0.2"
  }
}
